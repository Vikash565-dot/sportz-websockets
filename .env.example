DATABASE_URL=postgresql://user:password@host/database?sslmode=require
PORT=8000
HOST=0.0.0.0
ARCJET_KEY=
ARCJET_MODE=DRY_RUN
ARCJET_DISABLED=true

# Leave unset to run without caching. For local Redis, use redis://127.0.0.1:6379.
REDIS_URL=redis://127.0.0.1:6379

# Apache Kafka event streaming. Leave KAFKA_ENABLED=false to run without a broker.
KAFKA_ENABLED=true
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=sportz-api
KAFKA_MATCH_EVENTS_TOPIC=match-events
KAFKA_CONSUMER_GROUP=sportz-websocket
